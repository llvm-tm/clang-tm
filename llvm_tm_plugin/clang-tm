#!/usr/bin/env bash
# ============================================================
# clang-tm — one-command TM compilation pipeline
#
# A drop-in wrapper around clang++ that automatically runs the
# 4-stage TM instrumentation pipeline.  Accepts the same flags
# as clang++ for the final link step.
#
# The runtime is compiled to LLVM bitcode and merged with the
# instrumented source before the final -O3 pass, so that
# tm_read/tm_write calls are visible to the optimizer and can
# be inlined.
#
# Usage:
#   clang-tm [clang++ flags] source1.cpp [source2.cpp ...]
#   clang-tm --runtime FILE [clang++ flags] source1.cpp ...
#
# Examples:
#   clang-tm -std=c++20 -O3 -pthread -o myapp app.cpp
#   clang-tm --runtime SingleGlobalLock_runtime.cpp -o myapp app.cpp
#   clang-tm --runtime ../backends/runtimes/TinySTM_runtime.cpp \\
#            -DDESIGN_WBCTL -I ../backends/TinySTM -I ../backends \\
#            -std=c++20 -pthread -o myapp test_alloc_stress.cpp
#
# Flags:
#   --allow-opaque, -a
#       Suppress compilation error for opaque (uninstrumentable) function
#       calls inside transactions.  Use when external library functions
#       are known to be safe in TM context.
#   --strict-opaque, -s
#       Reject even known-safe opaque functions (e.g. printf, malloc, std::*).
#       Useful for auditing / strict validation.
#   --runtime FILE, -r FILE
#       Path to the TM runtime.  Accepts:
#         - .cpp/.cc/.cxx source  → compiled to bitcode, merged
#           with instrumented IR so the optimizer can inline
#         - .o/.a/.so/.dylib/.bc → linked as-is in the final step
#       Default: runtime.cpp (looked up in CWD and backends/runtimes/)
#   --plugin FILE, -p FILE
#       Path to libTMInstrument.so (default: auto-located).
#   --keep-temps, -k
#       Keep intermediate .bc files (under out/).
#   --verbose, -v
#       Print each pipeline step.
#   --help, -h
#       Show this message.
#
# All other flags are forwarded to clang++ unchanged.
# ============================================================

set -euo pipefail

# ---- Auto-discover paths ----
#
# Search order:
#   1. Relative to SCRIPT_DIR (development layout)
#   2. Installed layout (PREFIX/lib/clang-tm/)

# Resolve the actual script path, even when invoked from PATH
SCRIPT="$0"
if ! [ -f "$SCRIPT" ]; then
    SCRIPT="$(type -P "$0" 2>/dev/null || echo "$0")"
fi
# Resolve symlinks
if command -v realpath &>/dev/null; then
    SCRIPT="$(realpath "$SCRIPT")"
elif command -v greadlink &>/dev/null && greadlink -f "$SCRIPT" &>/dev/null; then
    SCRIPT="$(greadlink -f "$SCRIPT")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd 2>/dev/null || echo "$SCRIPT_DIR/..")"

# Check if installed (script in PREFIX/bin, data in PREFIX/lib/clang-tm)
if [ -d "$PROJECT_ROOT/lib/clang-tm" ]; then
    # Installed layout: /usr/local/bin/clang-tm
    #                    /usr/local/lib/clang-tm/{plugin,runtimes}
    INSTALLED_PREFIX="$PROJECT_ROOT"
    TM_INSTALL_DIR="$INSTALLED_PREFIX/lib/clang-tm"
    TM_RUNTIMES_DIR="$TM_INSTALL_DIR/runtimes"
    TM_BACKENDS_DIR="$TM_INSTALL_DIR"
    TM_PLUGIN_DIR="$TM_INSTALL_DIR/plugin"
else
    # Development layout: llvm_tm_plugin/clang-tm
    #                     llvm_tm_plugin/bin/libTMInstrument.so
    #                     backends/runtimes/
    TM_INSTALL_DIR=""
    TM_RUNTIMES_DIR="$(cd "$SCRIPT_DIR/../backends/runtimes" && pwd)"
    TM_BACKENDS_DIR="$(cd "$SCRIPT_DIR/../backends" && pwd)"
    TM_PLUGIN_DIR="$SCRIPT_DIR/bin"
fi

# ---- Discover LLVM tools ----
# Try versioned llvm-config first (apt.llvm.org installs
# clang++-22 / opt-22), then bare llvm-config.
LLVM_BINDIR=""
for cfg in llvm-config-22 llvm-config-22.1 llvm-config; do
    if command -v "$cfg" &>/dev/null; then
        LLVM_BINDIR="$("$cfg" --bindir 2>/dev/null || true)"
        [ -n "$LLVM_BINDIR" ] && break
    fi
done

CXX="${LLVM_BINDIR:+$LLVM_BINDIR/}clang++"
OPT="${LLVM_BINDIR:+$LLVM_BINDIR/}opt"
LLVM_LINK="${LLVM_BINDIR:+$LLVM_BINDIR/}llvm-link"

# ---- Defaults ----

RUNTIME="runtime.cpp"
PLUGIN=""
KEEP_TEMPS=0
VERBOSE=0
INLINE_PIPELINE=0
ALLOW_OPAQUE=0
STRICT_OPAQUE=0
OUTPUT=""
SOURCES=()
CXXFLAGS=()
OPT_LEVEL=""       # auto-detected from CXXFLAGS: O0, O1, O2, O3, Og, Os, Oz

# ---- Parse arguments ----

DEBUG_MODE=0
MODE="full"          # full, compile-only, instrument-only, optimize-only, link-only
PRINT_TOOL=""        # set to cxx/opt/llvm-link to print tool path and exit

while [ $# -gt 0 ]; do
    case "$1" in
        --runtime|-r)
            RUNTIME="$2"; shift 2 ;;
        --runtime=*)
            RUNTIME="${1#*=}"; shift ;;
        --plugin|-p)
            PLUGIN="$2"; shift 2 ;;
        --plugin=*)
            PLUGIN="${1#*=}"; shift ;;
        --debug|-g)
            DEBUG_MODE=1; shift ;;
        -a|--allow-opaque)
            ALLOW_OPAQUE=1; shift ;;
        --strict-opaque|-s)
            STRICT_OPAQUE=1; shift ;;
        -k|--keep-temps)
            KEEP_TEMPS=1; shift ;;
        -i|--inline)
            INLINE_PIPELINE=1; shift ;;
        -v|--verbose)
            VERBOSE=1; shift ;;
        --print-tool)
            PRINT_TOOL="$2"; shift 2 ;;
        --print-tool=*)
            PRINT_TOOL="${1#*=}"; shift ;;
        --compile-only)
            MODE="compile-only"; shift ;;
        --instrument-only)
            MODE="instrument-only"; shift ;;
        --optimize-only)
            MODE="optimize-only"; shift ;;
        --link-only)
            MODE="link-only"; shift ;;
        --passes=*|-passes=*)
            TM_PASSES="${1#*=}"; shift ;;
        --opaque-symbols-file=*)
            OPAQUE_SYMBOLS_FILE_ARG="${1#*=}"; shift ;;
        -o)
            OUTPUT="$2"; shift 2 ;;
        -h|--help)
            sed -n '/^#/s/^# \?//p' "$0"; exit 0 ;;
        --)
            shift; break ;;
        -I)
            CXXFLAGS+=("-I$2"); shift 2 ;;
        -O0|-O1|-O2|-O3|-Og|-Os|-Oz)
            OPT_LEVEL="$1"; shift ;;
        -*)
            CXXFLAGS+=("$1"); shift ;;
        *.cpp|*.cc|*.cxx)
            SOURCES+=("$(realpath "$1")"); shift ;;
        *.bc)
            if [ "$MODE" != "full" ]; then
                SOURCES+=("$(realpath "$1")"); shift
            else
                CXXFLAGS+=("$1"); shift
            fi ;;
        *)
            CXXFLAGS+=("$1"); shift ;;
    esac
done

while [ $# -gt 0 ]; do
    SOURCES+=("$(realpath "$1")"); shift
done

# ---- Locate runtime directories and define resolve_runtime ----

RUNTIMES_DIR="${TM_RUNTIMES_DIR:-$TM_BACKENDS_DIR/runtimes}"
BACKENDS_DIR="${TM_BACKENDS_DIR:-$PROJECT_ROOT/backends}"

resolve_runtime() {
    local path="$1"
    # Absolute or relative path that exists
    if [ -f "$path" ]; then
        realpath "$path"
        return 0
    fi
    local basename="$(basename "$path")"
    # Search in runtimes directory
    if [ -f "$RUNTIMES_DIR/$basename" ]; then
        realpath "$RUNTIMES_DIR/$basename"
        return 0
    fi
    return 1
}

# ---- Handle --print-tool ----

if [ -n "$PRINT_TOOL" ]; then
    case "$PRINT_TOOL" in
        cxx) echo "$CXX" ;;
        opt) echo "$OPT" ;;
        llvm-link) echo "$LLVM_LINK" ;;
        *) echo "clang-tm: unknown tool '$PRINT_TOOL' (cxx/opt/llvm-link)" >&2; exit 1 ;;
    esac
    exit 0
fi

# ---- Handle sub-mode operations (--compile-only, --instrument-only, etc.) ----
# These are used by tm_pipeline.mk for step-by-step builds.

if [ "$MODE" != "full" ]; then
    # For these modes, the last -o argument is the output file, and sources
    # are the input files (typically .bc files for instrument/optimize/link).

    if [ ${#SOURCES[@]} -eq 0 ]; then
        echo "clang-tm: no input files" >&2
        exit 1
    fi

    INPUT="${SOURCES[0]}"
    if [ -z "$OUTPUT" ]; then
        echo "clang-tm: --output required for $MODE mode" >&2
        exit 1
    fi

    # Temporary directory for intermediate files
    OUT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/clang-tm.XXXXXXXX")"
    trap 'rm -rf "$OUT_DIR"' EXIT
fi

if [ "$MODE" = "compile-only" ]; then
    # Compile source to bitcode (no instrumentation)
    COMPILE_CXXFLAGS=("${CXXFLAGS[@]+"${CXXFLAGS[@]}"}")
    [ -n "${OPT_LEVEL:-}" ] && COMPILE_CXXFLAGS+=("$OPT_LEVEL")
    $CXX -std=c++20 "${COMPILE_CXXFLAGS[@]}" -emit-llvm -c "$INPUT" -o "$OUTPUT"
    exit $?
fi

if [ "$MODE" = "instrument-only" ]; then
    # Run TM instrumentation on existing bitcode
    OPTS=()
    if [ -n "${TM_PASSES:-}" ]; then
        OPTS+=("-passes=$TM_PASSES")
    else
        OPTS+=("-passes=tm-instrument")
    fi
    [ -n "${OPAQUE_SYMBOLS_FILE_ARG:-}" ] && OPTS+=("-tm-opaque-symbols-file=$OPAQUE_SYMBOLS_FILE_ARG")
    [ "$ALLOW_OPAQUE" = 1 ] && OPTS+=("-tm-allow-opaque")
    # Pass through any additional flags (like -tm-allow-opaque, -tm-strict-opaque)
    for flag in "${CXXFLAGS[@]+"${CXXFLAGS[@]}"}"; do
        case "$flag" in
            -tm-*) OPTS+=("$flag") ;;
        esac
    done
    $OPT -load-pass-plugin="$PLUGIN" ${OPTS[@]+"${OPTS[@]}"} "$INPUT" -o "$OUTPUT"
    exit $?
fi

if [ "$MODE" = "optimize-only" ]; then
    # Optimize existing bitcode (typically -O3 to inline tm_read/tm_write)
    POST_OPT="${OPT_LEVEL:--O3}"
    $OPT $POST_OPT "$INPUT" -o "$OUTPUT"
    exit $?
fi

if [ "$MODE" = "link-only" ]; then
    # Link pre-instrumented bitcode with TM runtime source.
    # INPUT is the .opt.bc file; --runtime must be provided.
    # Compiles both together with clang++ (simplest approach).
    LINK_CXXFLAGS=("${CXXFLAGS[@]+"${CXXFLAGS[@]}"}")
    [ -n "${OPT_LEVEL:-}" ] && LINK_CXXFLAGS+=("$OPT_LEVEL")
    if [ -z "$RUNTIME" ] || [ "$RUNTIME" = "runtime.cpp" ]; then
        echo "clang-tm: --runtime required for link-only mode" >&2
        exit 1
    fi
    RESOLVED_RUNTIME="$(resolve_runtime "$RUNTIME")" || {
        echo "clang-tm: runtime not found: $RUNTIME" >&2
        exit 1
    }
    $CXX "${LINK_CXXFLAGS[@]}" "$INPUT" "$RESOLVED_RUNTIME" -o "$OUTPUT"
    exit $?
fi

# ---- Validate (full pipeline mode) ----

# ---- Locate plugin ----

if [ -z "$PLUGIN" ]; then
    # Try bare name first (install.sh creates this), fall back to _release
    PLUGIN="$TM_PLUGIN_DIR/libTMInstrument.so"
    if [ ! -f "$PLUGIN" ]; then
        PLUGIN="$TM_PLUGIN_DIR/libTMInstrument_release.so"
    fi
fi
if [ ! -f "$PLUGIN" ]; then
    echo "clang-tm: plugin not found at $TM_PLUGIN_DIR/libTMInstrument.so" >&2
    echo "  Set --plugin or run install.sh." >&2
    exit 1
fi

RESOLVED_RUNTIME="$(resolve_runtime "$RUNTIME")" || {
    echo "clang-tm: runtime not found: $RUNTIME" >&2
    echo "  Tried: $(realpath "$RUNTIME" 2>/dev/null || echo "$RUNTIME") and $RUNTIMES_DIR/$(basename "$RUNTIME")" >&2
    exit 1
}

# ---- Determine if runtime is source or library ----

runtime_is_source() {
    local path="$1"
    case "$path" in
        *.cpp|*.cc|*.cxx) return 0 ;;
        *) return 1 ;;
    esac
}

# ---- Add backend include path and split flags ----

COMPILE_FLAGS=("${CXXFLAGS[@]+"${CXXFLAGS[@]}"}")
LINK_FLAGS=()

# Suppress debug output in release mode (define NDEBUG for runtime compilation)
if [ "$DEBUG_MODE" -eq 0 ]; then
    COMPILE_FLAGS+=("-DNDEBUG")
fi

# ALLOW_OPAQUE is now handled as -tm-allow-opaque passed to opt
# (see Step 2 instrumentation below)

if [ -d "$BACKENDS_DIR" ]; then
    COMPILE_FLAGS+=("-I$BACKENDS_DIR")
fi

# Separate link-only flags from the rest
FILTERED_COMPILE=()
for f in "${COMPILE_FLAGS[@]+"${COMPILE_FLAGS[@]}"}"; do
    case "$f" in
        -l*|-L*|-Wl,*)
            LINK_FLAGS+=("$f") ;;
        *)
            FILTERED_COMPILE+=("$f") ;;
    esac
done
COMPILE_FLAGS=("${FILTERED_COMPILE[@]+"${FILTERED_COMPILE[@]}"}")
# Link flags get the remaining common flags too
for f in "${CXXFLAGS[@]+"${CXXFLAGS[@]}"}"; do
    case "$f" in
        -I*|-D*|-std=*|-stdlib=*)
            ;; # skip compile-only flags for linking
        -l*|-L*|-Wl,*)
            ;; # already added
        *)
            LINK_FLAGS+=("$f") ;;
    esac
done

# ---- Default output name ----

if [ -z "$OUTPUT" ]; then
    OUTPUT="./a.out"
fi

# ---- Build directory (unique per invocation for parallel safety) ----

if [ "$KEEP_TEMPS" -eq 0 ]; then
    OUT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/clang-tm.XXXXXXXX")"
    trap 'rm -rf "$OUT_DIR"' EXIT
else
    OUT_DIR="out"
    mkdir -p "$OUT_DIR"
fi

LINK_BCS=()
RUNTIME_BC=""
RUNTIME_IS_SOURCE=false

if runtime_is_source "$RESOLVED_RUNTIME"; then
    RUNTIME_IS_SOURCE=true
fi

log() { if [ "$VERBOSE" = 1 ]; then echo "$*"; fi; }

# ---- Determine optimization levels ----
# POST_OPT: optimization level for the final combined IR (post-instrumentation).
#   At -O3 (default), tm_read/tm_write calls get inlined. At -O0, they stay
#   as function calls — slower but preserves debug info.
if [ -n "$OPT_LEVEL" ]; then
    POST_OPT="$OPT_LEVEL"
else
    POST_OPT="-O3"
fi

# RUNTIME_OPT: optimization for the runtime source file. Use -O1 minimum so
#   that tm_read/tm_write can be inlined even at -O0, otherwise every single
#   load/store becomes a function call.
if [ -n "$OPT_LEVEL" ] && [ "$OPT_LEVEL" != "-O0" ]; then
    RUNTIME_OPT="$OPT_LEVEL"
else
    RUNTIME_OPT="-O1"
fi

# --- Instrument each source file ---

for src in "${SOURCES[@]}"; do
    base="$(basename "$src")"
    base_noext="${base%.*}"

    # Check if this source IS the runtime (same resolved path)
    if [ "$(realpath "$src" 2>/dev/null)" = "$RESOLVED_RUNTIME" ]; then
        log "[skip] $src is the runtime — not instrumenting"
        continue
    fi

    # Step 1: Compile to LLVM bitcode
    # Use user-specified -O level (defaults to -O1 for performance,
    # -O0 -g for debugging). The -fno-inline is required so that all
    # function bodies are visible to the instrumentation pass.
    bc="$OUT_DIR/$base_noext.bc"
    log "[1/4] $src → LLVM bitcode"
    if [ -n "$OPT_LEVEL" ]; then
        COMPILE_OPT="$OPT_LEVEL"
        if [ "$OPT_LEVEL" = "-O0" ]; then
            COMPILE_OPT="$COMPILE_OPT -g"
        fi
    else
        COMPILE_OPT="-O1"
    fi
    $CXX -std=c++20 $COMPILE_OPT -fno-inline -emit-llvm -c "$src" -o "$bc" \
        -fno-vectorize -fno-slp-vectorize -fno-unroll-loops \
        -fno-stack-protector -pthread "${COMPILE_FLAGS[@]+"${COMPILE_FLAGS[@]}"}"

    # Step 2: Instrument
    instr_bc="$OUT_DIR/$base_noext.instr.bc"
    PIPELINE="tm-instrument-then-inline"
    if [ "$INLINE_PIPELINE" -eq 1 ]; then
        PIPELINE="tm-instrument-inline"
    fi
    log "[2/4] $bc → instrumented IR ($PIPELINE)"
    OPTS=()
    [ "$ALLOW_OPAQUE" -eq 1 ] && OPTS+=("-tm-allow-opaque")
    [ "$STRICT_OPAQUE" -eq 1 ] && OPTS+=("-tm-strict-opaque")
    $OPT -load-pass-plugin="$PLUGIN" -passes="$PIPELINE" ${OPTS[@]+"${OPTS[@]}"} "$bc" -o "$instr_bc"

    LINK_BCS+=("$instr_bc")
done

# --- Compile runtime to bitcode (if source) ---

if $RUNTIME_IS_SOURCE; then
    runtime_base="$(basename "$RESOLVED_RUNTIME")"
    runtime_base_noext="${runtime_base%.*}"
    RUNTIME_BC="$OUT_DIR/${runtime_base_noext}.tm.bc"

    log "[rt] $RESOLVED_RUNTIME → LLVM bitcode"
    # NOTE: no -fno-inline — runtime functions are compiled separately at RUNTIME_OPT
    # so that they can be inlined into user code during the final POST_OPT pass.
    $CXX -std=c++20 $RUNTIME_OPT -emit-llvm -c "$RESOLVED_RUNTIME" -o "$RUNTIME_BC" \
        -fno-stack-protector -pthread "${COMPILE_FLAGS[@]+"${COMPILE_FLAGS[@]}"}"
fi

# --- Merge and optimize ---

if [ ${#LINK_BCS[@]} -eq 0 ]; then
    echo "clang-tm: no source files to instrument" >&2
    exit 1
fi

if $RUNTIME_IS_SOURCE && [ -n "$RUNTIME_BC" ]; then
    # Merge all instrumented BCs + runtime BC
    combined_bc="$OUT_DIR/combined.bc"

    if [ ${#LINK_BCS[@]} -eq 1 ]; then
        # Single source: just link with runtime BC
        log "[3/4] merging instrumented IR with runtime → $combined_bc"
        $LLVM_LINK "${LINK_BCS[0]}" "$RUNTIME_BC" -o "$combined_bc"
    else
        # Multiple sources: link all instrumented BCs first, then with runtime
        merged_src_bc="$OUT_DIR/sources_merged.bc"
        log "[3/4] merging ${#LINK_BCS[@]} instrumented IR files → $merged_src_bc"
        $LLVM_LINK "${LINK_BCS[@]+"${LINK_BCS[@]}"}" -o "$merged_src_bc"
        log "[3/4] merging instrumented IR with runtime → $combined_bc"
        $LLVM_LINK "$merged_src_bc" "$RUNTIME_BC" -o "$combined_bc"
    fi

    # Optimize the combined IR (sees both instrumented code and runtime)
    # Uses user's -O level (default -O3) to inline tm_read/tm_write etc.
    opt_bc="$OUT_DIR/combined.opt.bc"
    log "[4/4] optimizing combined IR → $opt_bc"
    $OPT $POST_OPT "$combined_bc" -o "$opt_bc"

    # Final link: compile bitcode to native binary
    log "[fin] linking → $OUTPUT"
    $CXX "${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"}" "$opt_bc" -o "$OUTPUT"
else
    # Runtime is a library (.o/.a/.so/.dylib/.bc): optimize then link

    if [ ${#LINK_BCS[@]} -eq 1 ]; then
        input_bc="${LINK_BCS[0]}"
        opt_bc="${input_bc%.*}.opt.bc"
        log "[3/4] optimizing instrumented IR → $opt_bc"
        $OPT $POST_OPT "$input_bc" -o "$opt_bc"
    else
        # Merge multiple sources first
        merged_src_bc="$OUT_DIR/sources_merged.bc"
        log "[3/4] merging ${#LINK_BCS[@]} instrumented IR files → $merged_src_bc"
        $LLVM_LINK "${LINK_BCS[@]+"${LINK_BCS[@]}"}" -o "$merged_src_bc"
        opt_bc="$OUT_DIR/sources_merged.opt.bc"
        log "[3/4] optimizing instrumented IR → $opt_bc"
        $OPT $POST_OPT "$merged_src_bc" -o "$opt_bc"
    fi

    # Link with runtime library
    log "[4/4] linking → $OUTPUT"
    $CXX "${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"}" "$opt_bc" "$RESOLVED_RUNTIME" -o "$OUTPUT"
fi

echo "clang-tm: built $OUTPUT" >&2
