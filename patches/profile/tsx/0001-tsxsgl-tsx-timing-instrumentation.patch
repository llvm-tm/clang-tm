From aed9f1b0e2c3d4f5a6b7c8d9e0f1a2b3c4d5e6f7 Mon Sep 17 00:00:00 2001
From: TM Profiling <tm-dev@example.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH 1/1] tsxsgl: add detailed TSX timing instrumentation

Adds RDTSC-based timing measurements for all TSX operations and the
SGL fallback path in the TSXSGL backend. Measurements are printed
as a TSX_STATS line at exit.

Collected metrics:
- xbegin_success: _xbegin() that entered TSX (cycles)
- xbegin_abort: _xbegin() that returned abort (cycles)
- xend: _xend() commit (cycles)
- xabort: _xabort() explicit abort (cycles)
- sgl_begin: SGL fallback lock acquisition (cycles from lock() to store())
- sgl_end: SGL release (cycles from store(0) to unlock())
- sgl_spin: spin-wait on LOCK_BUSY (cycles)
- read: tm_read_i4/8 (cycles)
- write: tm_write_i4/8 (cycles)
- read_set_size: per-commit estimated read-set size
- write_set_size: per-commit estimated write-set size
- abort_reason: cumulative abort reason codes
- tsx_depth: duration of _xbegin().._xend() (cycles)

diff --git a/backends/tm_impl/tsx_sgl/TSXSGL_runtime.cpp b/backends/tm_impl/tsx_sgl/TSXSGL_runtime.cpp
index abcdef1..1234567 100644
--- a/backends/tm_impl/tsx_sgl/TSXSGL_runtime.cpp
+++ b/backends/tm_impl/tsx_sgl/TSXSGL_runtime.cpp
@@ -1,4 +1,12 @@
 /**
+ * TSXSGL with TSX Timing Instrumentation
+ *
+ * Define TSX_PROFILE to activate detailed cycle-level timing.
+ * Prints TSX_STATS at exit.
+ *
+ * Metrics use RDTSC.  Cycle counts are affected by turbo boost,
+ * frequency scaling, and out-of-order execution — treat as
+ * approximate distributions, not exact cycle counts.
+ *
  * TSXSGL: TSX Lock Elision with Single Global Lock fallback.
  *
  * Uses Intel TSX (RTM) for optimistic concurrency. On RTM failure
@@ -10,14 +18,6 @@
  * - sgl_owner: 1 = SGL held, 0 = free
  *
  * The sgl_owner cache-line is added to the TSX read-set on begin().
- * Any concurrent SGL entry (which writes to sgl_owner) aborts the TSX.
- * The write forces a cache-line invalidation to the read-set, causing
- * an immediate TSX abort (wasted-work prevention).
- *
- * Abort handling distinguishes:
- *   LOCK_BUSY (0xFF) — explicit _xabort from sgl_owner check
- *   OWNER_CHANGED (0x01) — explicit _xabort from end() re-check
- *   Other — hardware conflict or capacity abort
  */

 #include <algorithm>
@@ -39,6 +39,21 @@
 #include <new>
 #include <sstream>

+// ── Profiling instrumentation ───────────────────────────────
+// #define TSX_PROFILE  // uncomment to enable
+#ifdef TSX_PROFILE
+  #include <cstdio>
+  #include <atomic>
+  #define TSX_RDTSC() uint64_t __tsx_tsc; \
+      do { uint32_t lo, hi; asm volatile("rdtsc" : "=a"(lo), "=d"(hi)); \
+      __tsx_tsc = ((uint64_t)hi << 32) | lo; } while(0)
+  // thread-local accumulators
+  #define TSX_ACC(name, start, end) do { \
+      tsx_acc_##name.fetch_add((end) - (start), std::memory_order_relaxed); \
+      tsx_cnt_##name.fetch_add(1, std::memory_order_relaxed); } while(0)
+#else
+  #define TSX_RDTSC() ((void)0)
+#endif
+
 #ifdef __x86_64__

 // ---- TM allocator integration ----
@@ -60,6 +75,34 @@ static std::mutex global_tx_lock;
 static std::atomic<uint64_t> sgl_owner{0};
 static std::atomic<uint64_t> g_spin_count{0};

+// ── TSX profile counters (atomically aggregated) ────────────
+#ifdef TSX_PROFILE
+static std::atomic<uint64_t> tsx_acc_xbegin_ok{0};
+static std::atomic<uint64_t> tsx_cnt_xbegin_ok{0};
+static std::atomic<uint64_t> tsx_acc_xbegin_abort{0};
+static std::atomic<uint64_t> tsx_cnt_xbegin_abort{0};
+static std::atomic<uint64_t> tsx_acc_xend{0};
+static std::atomic<uint64_t> tsx_cnt_xend{0};
+static std::atomic<uint64_t> tsx_acc_xabort{0};
+static std::atomic<uint64_t> tsx_cnt_xabort{0};
+static std::atomic<uint64_t> tsx_acc_sgl_begin{0};
+static std::atomic<uint64_t> tsx_cnt_sgl_begin{0};
+static std::atomic<uint64_t> tsx_acc_sgl_end{0};
+static std::atomic<uint64_t> tsx_cnt_sgl_end{0};
+static std::atomic<uint64_t> tsx_acc_sgl_spin{0};
+static std::atomic<uint64_t> tsx_cnt_sgl_spin{0};
+static std::atomic<uint64_t> tsx_acc_read{0};
+static std::atomic<uint64_t> tsx_cnt_read{0};
+static std::atomic<uint64_t> tsx_acc_write{0};
+static std::atomic<uint64_t> tsx_cnt_write{0};
+static std::atomic<uint64_t> tsx_acc_depth{0};
+static std::atomic<uint64_t> tsx_cnt_depth{0};
+static std::atomic<uint64_t> tsx_abort_conflict{0};
+static std::atomic<uint64_t> tsx_abort_capacity{0};
+static std::atomic<uint64_t> tsx_abort_explicit{0};
+static std::atomic<uint64_t> tsx_abort_other{0};
+#endif
+
 // ---- Thread-local state ----
 thread_local bool g_in_tx = false;
 thread_local bool in_tsx = false;
@@ -71,6 +114,9 @@ thread_local bool in_tsx = false;
 static thread_local uint64_t tm_rdtsc_begin = 0;
 static thread_local uint64_t tm_rdtsc_reads = 0;
 static thread_local uint64_t tm_rdtsc_writes = 0;
+static thread_local uint64_t tsx_depth_start = 0;
+static thread_local uint64_t tsx_read_set_count = 0;
+static thread_local uint64_t tsx_write_set_count = 0;
 static thread_local uint64_t tm_begin_count = 0;
 static thread_local uint64_t tm_commit_count = 0;

@@ -81,6 +127,9 @@ static void print_stats() {
         fprintf(stderr, "[TSXSGL] tm_avg_duration = %.0f cycles\n",
                 (double)tm_rdtsc_begin / cnt);
     }
+    if (cnt > 0) {
+        fprintf(stderr, "[TSXSGL] tm_avg_reads = %.1f, tm_avg_writes = %.1f\n",
+                (double)tm_rdtsc_reads / cnt, (double)tm_rdtsc_writes / cnt);
+    }
 }
 #endif

@@ -96,6 +145,39 @@ void tm_init() {
         tm_event_log_init();
     }

+#ifdef TSX_PROFILE
+    // Register an atexit handler to print profile data
+    // (using atexit rather than destructors for portability)
+    static bool registered = false;
+    if (!registered) {
+        registered = true;
+        auto dump = []() {
+            auto ok = tsx_cnt_xbegin_ok.load();
+            auto ab = tsx_cnt_xbegin_abort.load();
+            auto xd = tsx_cnt_xend.load();
+            auto xa = tsx_cnt_xabort.load();
+            auto sb = tsx_cnt_sgl_begin.load();
+            auto se = tsx_cnt_sgl_end.load();
+            auto ss = tsx_cnt_sgl_spin.load();
+            auto rd = tsx_cnt_read.load();
+            auto wr = tsx_cnt_write.load();
+            auto dp = tsx_cnt_depth.load();
+            fprintf(stdout,
+                "TSX_STATS:"
+                " xbegin_ok=%llu(%llu) xbegin_abort=%llu(%llu)"
+                " xend=%llu(%llu) xabort=%llu(%llu)"
+                " sgl_begin=%llu(%llu) sgl_end=%llu(%llu) sgl_spin=%llu(%llu)"
+                " read=%llu(%llu) write=%llu(%llu)"
+                " depth=%llu(%llu)"
+                " conflict=%llu capacity=%llu explicit=%llu other=%llu\n",
+                (unsigned long long)ok, (unsigned long long)tsx_acc_xbegin_ok.load(),
+                (unsigned long long)ab, (unsigned long long)tsx_acc_xbegin_abort.load(),
+                (unsigned long long)xd, (unsigned long long)tsx_acc_xend.load(),
+                (unsigned long long)xa, (unsigned long long)tsx_acc_xabort.load(),
+                (unsigned long long)sb, (unsigned long long)tsx_acc_sgl_begin.load(),
+                (unsigned long long)se, (unsigned long long)tsx_acc_sgl_end.load(),
+                (unsigned long long)ss, (unsigned long long)tsx_acc_sgl_spin.load(),
+                (unsigned long long)rd, (unsigned long long)tsx_acc_read.load(),
+                (unsigned long long)wr, (unsigned long long)tsx_acc_write.load(),
+                (unsigned long long)dp, (unsigned long long)tsx_acc_depth.load(),
+                (unsigned long long)tsx_abort_conflict.load(),
+                (unsigned long long)tsx_abort_capacity.load(),
+                (unsigned long long)tsx_abort_explicit.load(),
+                (unsigned long long)tsx_abort_other.load());
+        };
+        std::atexit(dump);
+    }
+#endif
+
     tm_register_real_hooks(&g_tsxsgl_hooks);
     stm::tm_region_init();
 }
@@ -113,6 +195,19 @@ void tm_init_thread() {
     tm_event_log_init_thread();
 }

+// ── Write-set size estimation ───────────────────────────────
+// We approximate write-set size by tracking unique cache-line-aligned
+// addresses written within the current TSX region.  This is a
+// coarse proxy — the actual write-set is in the L1 cache.
+static thread_local std::unordered_set<uintptr_t> tsx_write_set_lines;
+static void tsx_track_write(void *addr) {
+    uintptr_t line = reinterpret_cast<uintptr_t>(addr) >> 6;  // 64-byte lines
+    tsx_write_set_lines.insert(line);
+}

+// ── Read-set size estimation ────────────────────────────────
+// Track unique cache-line-aligned addresses read.
+static thread_local std::unordered_set<uintptr_t> tsx_read_set_lines;
+static void tsx_track_read(void *addr) {
+    uintptr_t line = reinterpret_cast<uintptr_t>(addr) >> 6;
+    tsx_read_set_lines.insert(line);
+}
+
 // ── Real implementations (registered via hooks) ─────────────────────

 static void real_tm_begin() {
@@ -121,10 +216,18 @@ static void real_tm_begin() {

 #if defined(__x86_64__) || defined(__i386__)
     if (tm_rtm::available()) {
+        tsx_depth_start = 0;
+        tsx_read_set_count = 0;
+        tsx_write_set_count = 0;
+        tsx_write_set_lines.clear();
+        tsx_read_set_lines.clear();
         for (int attempts = 0; attempts < 5; attempts++) {
+            TSX_RDTSC();
+            uint64_t tsx_try_tsc = __tsx_tsc;
             unsigned status = _xbegin();
+            uint64_t xb_end;
+            TSX_RDTSC();
+            xb_end = __tsx_tsc;
             if (status == _XBEGIN_STARTED) {
+                TSX_ACC(xbegin_ok, tsx_try_tsc, xb_end);
+                tsx_depth_start = xb_end;
                 uint64_t v = sgl_owner.load(std::memory_order_seq_cst);
                 if (v != 0) {
+                    TSX_RDTSC();
+                    uint64_t xa_start = __tsx_tsc;
                     _xabort(LOCK_BUSY);
+                    // _xabort restores to _xbegin — never reached
                 }
                 tsx_start_owner = v;
                 in_tsx = true;
                 return;
             }
+            TSX_ACC(xbegin_abort, tsx_try_tsc, xb_end);
+            // Categorize abort reason
+            if (status & _XABORT_EXPLICIT) {
+                tsx_abort_explicit.fetch_add(1, std::memory_order_relaxed);
+            } else if (status & _XABORT_CAPACITY) {
+                tsx_abort_capacity.fetch_add(1, std::memory_order_relaxed);
+            } else if (status & _XABORT_CONFLICT) {
+                tsx_abort_conflict.fetch_add(1, std::memory_order_relaxed);
+            } else {
+                tsx_abort_other.fetch_add(1, std::memory_order_relaxed);
+            }

-            if ((status & _XABORT_EXPLICIT) &&
-                _XABORT_CODE(status) == LOCK_BUSY) {
+            if ((status & _XABORT_EXPLICIT) && _XABORT_CODE(status) == LOCK_BUSY) {
+                TSX_RDTSC();
+                uint64_t spin_start = __tsx_tsc;
                 while (sgl_owner.load(std::memory_order_relaxed) != 0)
                     _mm_pause();
+                TSX_RDTSC();
+                TSX_ACC(sgl_spin, spin_start, __tsx_tsc);
             } else if (!(status & _XABORT_RETRY)) {
                 break;
             }
         }
     }
 #endif
+    TSX_RDTSC();
+    uint64_t sgl_begin_tsc = __tsx_tsc;
     global_tx_lock.lock();
     sgl_owner.store(1, std::memory_order_seq_cst);
+    TSX_RDTSC();
+    TSX_ACC(sgl_begin, sgl_begin_tsc, __tsx_tsc);
     in_tsx = false;
 }

 static void real_tm_end() {
     if (tm_nested_call_counter > 1) return;
     g_in_tx = false;

+    TSX_RDTSC();
+    uint64_t end_start = __tsx_tsc;
+
     if (in_tsx) {
 #if defined(__x86_64__) || defined(__i386__)
         if (sgl_owner.load(std::memory_order_seq_cst) != tsx_start_owner) {
+            TSX_RDTSC();
+            uint64_t xa_tsc = __tsx_tsc;
             _xabort(OWNER_CHANGED);
+            // never reached
         }
+        tsx_read_set_count = tsx_read_set_lines.size();
+        tsx_write_set_count = tsx_write_set_lines.size();
         _xend();
+        TSX_RDTSC();
+        TSX_ACC(xend, end_start, __tsx_tsc);
+        if (tsx_depth_start != 0) {
+            TSX_ACC(depth, tsx_depth_start, __tsx_tsc);
+        }
 #endif
+        tm_rdtsc_reads += tsx_read_set_count;
+        tm_rdtsc_writes += tsx_write_set_count;
         return;
     }
+    TSX_RDTSC();
+    uint64_t sgl_rel_tsc = __tsx_tsc;
     sgl_owner.store(0, std::memory_order_seq_cst);
     global_tx_lock.unlock();
+    TSX_RDTSC();
+    TSX_ACC(sgl_end, sgl_rel_tsc, __tsx_tsc);
 }

-static uint8_t  real_tm_read_i1(uint8_t *addr)  { return *addr; }
-static uint16_t real_tm_read_i2(uint16_t *addr) { return *addr; }
-static uint32_t real_tm_read_i4(uint32_t *addr) { return *addr; }
-static uint64_t real_tm_read_i8(uint64_t *addr) { return *addr; }
-static float    real_tm_read_f4(float *addr)    { return *addr; }
-static double   real_tm_read_f8(double *addr)   { return *addr; }
-static void *   real_tm_read_ptr(void **addr)   { return (void*)*addr; }
+// ---- Read hooks with timing ----
+#define TSX_READ_HOOK(name, type, ret_type) \
+static ret_type real_tm_##name(type *addr) { \
+    TSX_RDTSC(); uint64_t r_tsc = __tsx_tsc; \
+    ret_type v = *addr; \
+    TSX_RDTSC(); TSX_ACC(read, r_tsc, __tsx_tsc); \
+    if (in_tsx) tsx_track_read(addr); \
+    return v; \
+}

+TSX_READ_HOOK(read_i1, uint8_t, uint8_t)
+TSX_READ_HOOK(read_i2, uint16_t, uint16_t)
+TSX_READ_HOOK(read_i4, uint32_t, uint32_t)
+TSX_READ_HOOK(read_i8, uint64_t, uint64_t)
+TSX_READ_HOOK(read_f4, float, float)
+TSX_READ_HOOK(read_f8, double, double)
+TSX_READ_HOOK(read_ptr, void*, void*)

-static void real_tm_write_i1(uint8_t *addr, uint8_t val)     { *addr = val; }
-static void real_tm_write_i2(uint16_t *addr, uint16_t val)   { *addr = val; }
-static void real_tm_write_i4(uint32_t *addr, uint32_t val)   { *addr = val; }
-static void real_tm_write_i8(uint64_t *addr, int64_t val)    { *(volatile uint64_t*)addr = (uint64_t)val; }
-static void real_tm_write_f4(float *addr, float val)         { *addr = val; }
-static void real_tm_write_f8(double *addr, double val)       { *addr = val; }
-static void real_tm_write_ptr(void **addr, void *val)        { *addr = val; }
+#define TSX_WRITE_HOOK(name, type, val_type) \
+static void real_tm_##name(type *addr, val_type val) { \
+    TSX_RDTSC(); uint64_t w_tsc = __tsx_tsc; \
+    *addr = val; \
+    TSX_RDTSC(); TSX_ACC(write, w_tsc, __tsx_tsc); \
+    if (in_tsx) tsx_track_write(addr); \
+}

+TSX_WRITE_HOOK(write_i1, uint8_t, uint8_t)
+TSX_WRITE_HOOK(write_i2, uint16_t, uint16_t)
+TSX_WRITE_HOOK(write_i4, uint32_t, uint32_t)
+TSX_WRITE_HOOK(write_i8, uint64_t, int64_t)
+TSX_WRITE_HOOK(write_f4, float, float)
+TSX_WRITE_HOOK(write_f8, double, double)
+TSX_WRITE_HOOK(write_ptr, void*, void*)

 static void* real_tm_malloc(size_t size) {
     void* p = stm::tm_region_malloc(size);

- -- 
