#!/bin/bash
# tm-race-checker — wrapper around opt for the TM race detection pass
#
# Usage:
#   tm-race-checker input.bc [-o output.bc] [--version]
#
# Default output is /dev/null (just see diagnostics on stderr).

VERSION="1.0.0"

if [ "$1" = "--version" ] || [ "$1" = "-V" ]; then
    cat <<'EOF'
    ┏━━━┓┏━━━┓┏━━━┓┏━━━┓
    ┃┏━┓┃┃┏━┓┃┃┏━┓┃┃┏━━┛
    ┃┗━┛┃┃┃━┃┃┃┃━┗┛┃┗━━┓
    ┃┏┓┏┛┃┗━┛┃┃┃━┏┓┃┏━━┛
    ┃┃┃┗┓┃┏━┓┃┃┗━┛┃┃┗━━┓
    ┗┛┗━┛┗┛━┗┛┗━━━┛┗━━━┛
       .-----------,-.-----.
       |:_r_a_c_e//(_)\t_m_|:
    ___||=======// ,--.\===.|  ___
  .'.""'\\____.'/ | (__)\__|\.'.""'.
  | |"""||._       '---'__   `-|"""|
  | |"""||. '-.___  ` -'--'     `-.| ___
  | |"""|| '-.'.""'.----._     .---:'.""'.
  `.'_".'|   | |"""|_____ `. /\ \___||_""|
          '-.| |""_/_____\  \ \\ \_____\_|
             | |"|____    ', '.__/   ____|
             `.'__.'  `'---'-'---'-'.'__.'
┏━━━┓┏┓━┏┓┏━━━┓┏━━━┓┏┓┏━┓┏━━━┓┏━━━┓
┃┏━┓┃┃┃━┃┃┃┏━━┛┃┏━┓┃┃┃┃┏┛┃┏━━┛┃┏━┓┃
┃┃━┗┛┃┗━┛┃┃┗━━┓┃┃━┗┛┃┗┛┛━┃┗━━┓┃┗━┛┃
┃┃━┏┓┃┏━┓┃┃┏━━┛┃┃━┏┓┃┏┓┃━┃┏━━┛┃┏┓┏┛
┃┗━┛┃┃┃━┃┃┃┗━━┓┃┗━┛┃┃┃┃┗┓┃┗━━┓┃┃┃┗┓
┗━━━┛┗┛━┗┛┗━━━┛┗━━━┛┗┛┗━┛┗━━━┛┗┛┗━┛
EOF
echo "tm-race-checker version ${VERSION}"
    exit 0
fi

PLUGIN_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN="$PLUGIN_DIR/libTMRaceChecker.so"

if [ ! -f "$PLUGIN" ]; then
    echo "ERROR: libTMRaceChecker.so not found in $PLUGIN_DIR" >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "Usage: tm-race-checker <input.bc> [-o output.bc] [--version]" >&2
    exit 1
fi

INPUT="$1"
shift

OUTPUT="/dev/null"
if [ "$1" = "-o" ] && [ -n "$2" ]; then
    OUTPUT="$2"
    shift 2
fi

opt-22 -load-pass-plugin="$PLUGIN" -passes="tm-race-checker" "$INPUT" -o "$OUTPUT" "$@"
