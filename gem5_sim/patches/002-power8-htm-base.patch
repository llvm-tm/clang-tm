+/*
+ * POWER8 Transactional Memory (HTM) instructions: tbegin, tend,
+ * tabort, tcheck, tsr, tresume, tsuspend.
+ */
+
+#ifndef __ARCH_POWER_INSTS_TM_HH__
+#define __ARCH_POWER_INSTS_TM_HH__
+
+#include "arch/power/insts/static_inst.hh"
+
+namespace gem5
+{
+
+namespace PowerISA
+{
+
+/**
+ * Base class for memory-fence-style HTM management instructions
+ * (HTM_START / HTM_COMMIT / HTM_CANCEL). These are non-speculative
+ * memory operations that drive the Ruby L0 HTM controller.
+ */
+class HtmMemInst : public PowerStaticInst
+{
+  public:
+    HtmMemInst(const char *mnem, ExtMachInst _machInst, OpClass __opClass)
+        : PowerStaticInst(mnem, _machInst, __opClass)
+    {
+        flags[IsNonSpeculative] = true;
+        flags[IsMemoryRef] = true;
+        flags[IsQuiesce] = true;
+    }
+};
+
+/** tbegin. t  (XO=0x28e, R=bit25, L=bit21) */
+class TBeginInst : public HtmMemInst
+{
+  public:
+    TBeginInst(ExtMachInst _machInst, uint64_t _L)
+        : HtmMemInst("tbegin", _machInst, MemReadOp), L(_L)
+    {
+        flags[IsHtmStart] = true;
+        flags[IsLoad] = true;
+        flags[IsInteger] = true;
+    }
+
+    Fault initiateAcc(ExecContext *xc,
+                      trace::InstRecord *traceData) const override;
+    Fault completeAcc(PacketPtr pkt, ExecContext *xc,
+                      trace::InstRecord *traceData) const override;
+
+  private:
+    uint64_t L;
+};
+
+/** tend. (XO=0x2ae, all >tendall if BA bit25) */
+class TEndInst : public HtmMemInst
+{
+  public:
+    TEndInst(ExtMachInst _machInst)
+        : HtmMemInst("tend", _machInst, MemReadOp)
+    {
+        flags[IsHtmStop] = true;
+        flags[IsLoad] = true;
+    }
+
+    Fault initiateAcc(ExecContext *xc,
+                      trace::InstRecord *traceData) const override;
+    Fault completeAcc(PacketPtr pkt, ExecContext *xc,
+                      trace::InstRecord *traceData) const override;
+};
+
+/** tabort. (XO=0x38e, RA has abort code) */
+class TAbortInst : public HtmMemInst
+{
+  public:
+    TAbortInst(ExtMachInst _machInst)
+        : HtmMemInst("tabort", _machInst, MemReadOp)
+    {
+        flags[IsHtmCancel] = true;
+        flags[IsLoad] = true;
+    }
+
+    Fault initiateAcc(ExecContext *xc,
+                      trace::InstRecord *traceData) const override;
+    Fault completeAcc(PacketPtr pkt, ExecContext *xc,
+                      trace::InstRecord *traceData) const override;
+};
+
+/** tcheck (XO=0x2ce): writes CR field BF, memory-free */
+class TCheckInst : public PowerStaticInst
+{
+  public:
+    TCheckInst(ExtMachInst _machInst, uint64_t _BF)
+        : PowerStaticInst("tcheck", _machInst, IntAluOp), BF(_BF)
+    {
+        flags[IsInteger] = true;
+    }
+
+    Fault execute(ExecContext *xc,
+                  trace::InstRecord *traceData) const override;
+
+  private:
+    uint64_t BF;
+};
+
+/** tsr (XO=0x2ee, L=bit21), tresume, tsuspend: memory-free */
+class TSrInst : public PowerStaticInst
+{
+  public:
+    TSrInst(ExtMachInst _machInst, uint64_t _L)
+        : PowerStaticInst("tsr", _machInst, IntAluOp), L(_L)
+    {
+        flags[IsInteger] = true;
+    }
+
+    Fault execute(ExecContext *xc,
+                  trace::InstRecord *traceData) const override;
+
+  private:
+    uint64_t L;
+};
+
+} // namespace PowerISA
+} // namespace gem5
+
+#endif // __ARCH_POWER_INSTS_TM_HH__
