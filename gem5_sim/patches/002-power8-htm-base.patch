+namespace gem5
+{
+
+namespace PowerISA
+{
+
+void
+HTMCheckpoint::reset()
+{
+    gpr.fill(0);
+    fpr.fill(0);
+    cr = 0;
+    xer = 0;
+    lr = 0;
+    ctr = 0;
+    tar = 0;
+    fpscr = 0;
+    msr = 0;
+    rsv = 0;
+    rsvAddr = 0;
+    nPc = 0;
+    texasr = 0;
+    tfiar = 0;
+    BaseHTMCheckpoint::reset();
+}
+
+void
+HTMCheckpoint::save(ThreadContext *tc)
+{
+    for (auto n = 0; n < int_reg::NumArchRegs; n++)
+        gpr[n] = tc->getReg(intRegClass[n]);
+    for (auto n = 0; n < 32; n++)
+        fpr[n] = tc->getReg(floatRegClass[n]);
+    cr = tc->getReg(int_reg::Cr);
+    xer = tc->getReg(int_reg::Xer);
+    lr = tc->getReg(int_reg::Lr);
+    ctr = tc->getReg(int_reg::Ctr);
+    tar = tc->getReg(int_reg::Tar);
+    fpscr = tc->getReg(int_reg::Fpscr);
+    msr = tc->getReg(int_reg::Msr);
+    rsv = tc->getReg(int_reg::Rsv);
+    rsvAddr = tc->getReg(int_reg::RsvAddr);
+
+    BaseHTMCheckpoint::save(tc);
+}
+
+void
+HTMCheckpoint::restore(ThreadContext *tc, HtmFailureFaultCause cause)
+{
+    for (auto n = 0; n < int_reg::NumArchRegs; n++)
+        tc->setReg(intRegClass[n], gpr[n]);
+    for (auto n = 0; n < 32; n++)
+        tc->setReg(floatRegClass[n], fpr[n]);
+    tc->setReg(int_reg::Cr, cr);
+    tc->setReg(int_reg::Xer, xer);
+    tc->setReg(int_reg::Lr, lr);
+    tc->setReg(int_reg::Ctr, ctr);
+    tc->setReg(int_reg::Tar, tar);
+    tc->setReg(int_reg::Fpscr, fpscr);
+
+    // Non-transactional state on rollback
+    Msr msrReg = msr;
+    msrReg.ts = 0;
+    tc->setReg(int_reg::Msr, msrReg);
+
+    // Clear the reservation (lwarx/stcx sequence inside the tx)
+    tc->setReg(int_reg::Rsv, 0);
+    tc->setReg(int_reg::RsvAddr, 0);
+
+    // Set CR0[EQ]=1 so the software fallback follows
+    //   `tbegin.; beq abort_handler`  (EQ=1 => abort taken)
+    // Verified vs kernel doc + LLVM HTM builtins comment
+    // ("successfully started (0) or failed (1)").
+    Cr crReg = cr;
+    crReg.cr0.lt = 0;
+    crReg.cr0.gt = 0;
+    crReg.cr0.eq = 1;
+    crReg.cr0.so = 0;
+    tc->setReg(int_reg::Cr, crReg);
+
+    // Record abort status in TEXASR / TFIAR
+    // Failure code layout (kept aligned with Power8HTM.tla FMAbort):
+    //   bit0 = EXPLICIT, bit1 = CONFLICT/MEMORY, bit2 = CAPACITY/SIZE,
+    //   bit4 = NEST, bit8+ = abort code / EXCEPTION / OTHER.
+    uint64_t failureCode = 0;
+    switch (cause) {
+      case HtmFailureFaultCause::EXPLICIT:
+        failureCode = 1ull;
+        break;
+      case HtmFailureFaultCause::MEMORY:
+        failureCode = 1ull << 1;
+        break;
+      case HtmFailureFaultCause::SIZE:
+        failureCode = 1ull << 2;
+        break;
+      case HtmFailureFaultCause::NEST:
+        failureCode = 1ull << 4;
+        break;
+      case HtmFailureFaultCause::EXCEPTION:
+        failureCode = 1ull << 5;
+        break;
+      case HtmFailureFaultCause::OTHER:
+      default:
+        failureCode = 1ull << 6;
+        break;
+    }
+    texasr = failureCode;
+    tfiar = nPc;    // fallback address; real HW would store failing inst
+    tc->setReg(int_reg::Texasr, texasr);
+    tc->setReg(int_reg::Tfiar, tfiar);
+
+    // Redirect to TFHAR (fallback handler registered by tbegin.)
+    PCState pc = tc->pcState().as<PCState>();
+    pc.set(nPc);
+    tc->pcState(pc);
+
+    BaseHTMCheckpoint::restore(tc, cause);
+}
+
+} // namespace PowerISA
+} // namespace gem5
