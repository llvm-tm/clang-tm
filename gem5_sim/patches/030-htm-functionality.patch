diff --git a/src/sim/faults.cc b/src/sim/faults.cc
index 7c37e58a7a..ce9dd0f8da 100644
--- a/src/sim/faults.cc
+++ b/src/sim/faults.cc
@@ -45,6 +45,7 @@
 #include "arch/generic/decoder.hh"
 #include "base/logging.hh"
 #include "cpu/base.hh"
+#include "cpu/reg_class.hh"
 #include "cpu/thread_context.hh"
 #include "debug/Faults.hh"
 #include "mem/page_table.hh"
@@ -113,7 +114,7 @@ GenericAlignmentFault::invoke(ThreadContext *tc, const StaticInstPtr &inst)
 }
 
 void GenericHtmFailureFault::invoke(ThreadContext *tc,
-                                    const StaticInstPtr &inst)
+                                     const StaticInstPtr &inst)
 {
     // reset decoder
     InstDecoder* dcdr = tc->getDecoderPtr();
@@ -126,6 +127,45 @@ void GenericHtmFailureFault::invoke(ThreadContext *tc,
 
     checkpoint->restore(tc, getHtmFailureFaultCause());
 
+    // Set EAX abort status to match Intel RTM encoding so the
+    // retry loop in TSXSGL_runtime.cpp observes LOCK_BUSY/CONFLICT
+    // correctly. The checkpoint restore recovered the pre-XBEGIN
+    // RAX, so we must overwrite it here.
+    // Intel bits: 0=EXPLICIT,1=RETRY,2=CONFLICT,3=CAPACITY,
+    // 4=DEBUG,5=NESTED,24..31=code
+    uint64_t status = 0;
+    switch (cause) {
+      case HtmFailureFaultCause::EXPLICIT:
+        status = (1u << 0) | (uint64_t(abortCode) << 24) | (1u << 1); // retryable explicit
+        break;
+      case HtmFailureFaultCause::MEMORY:
+        status = (1u << 2); // conflict (LD_FAIL/ST_FAIL both MEMORY)
+        break;
+      case HtmFailureFaultCause::SIZE:
+        status = (1u << 3); // capacity, not retryable
+        break;
+      case HtmFailureFaultCause::NEST:
+        status = (1u << 5); // nested transaction abort
+        break;
+      case HtmFailureFaultCause::OTHER:
+      case HtmFailureFaultCause::EXCEPTION:
+      default:
+        status = 0; // unclassified: no Intel cause bit
+        break;
+    }
+    // X86 RAX is intReg 0. Set abort status there for TSX retry loops
+    // to observe LOCK_BUSY/CONFLICT correctly. Use ISA's regClasses to
+    // construct the RegId portably (IntRegClass is a type enum, not a
+    // RegClass object).
+    try {
+        auto *isa = tc->getIsaPtr();
+        if (isa && isa->regClasses().size() > (size_t)IntRegClass) {
+            const RegClass *rcPtr = isa->regClasses()[IntRegClass];
+            if (rcPtr && rcPtr->numRegs() > 0) {
+                tc->setReg(RegId(*rcPtr, 0), status);
+            }
+        }
+    } catch (...) {
+        // Non-x86 or missing reg class: ignore
+    }
+
     // reset the global monitor
     tc->getIsaPtr()->globalClearExclusive();
 
