diff --git a/src/arch/x86/insts/htmruby.cc b/src/arch/x86/insts/htmruby.cc
new file mode 100644
index 0000000000..cf88d6c6b6
--- /dev/null
+++ b/src/arch/x86/insts/htmruby.cc
@@ -0,0 +1,174 @@
+#include "arch/x86/insts/htm.hh"
+
+#include "arch/generic/memhelpers.hh"
+#include "arch/x86/faults.hh"
+#include "arch/x86/htm.hh"
+#include "cpu/exec_context.hh"
+#include "debug/X86.hh"
+#include "mem/htm.hh"
+#include "mem/packet.hh"
+#include "mem/packet_access.hh"
+#include "mem/request.hh"
+
+namespace gem5
+{
+
+using namespace X86ISA;
+
+namespace X86ISAInst
+{
+
+Fault
+XBeginInst::initiateAcc(ExecContext *xc, trace::InstRecord *traceData) const
+{
+    Fault fault = NoFault;
+    const uint64_t htm_depth = xc->getHtmTransactionalDepth();
+
+    DPRINTF(X86, "XBEGIN: htm depth is %d\n", htm_depth);
+
+    if (htm_depth > X86ISA::HTMCheckpoint::MAX_HTM_DEPTH) {
+        const uint64_t htm_uid = xc->getHtmTransactionUid();
+        fault = std::make_shared<GenericHtmFailureFault>(
+            htm_uid, HtmFailureFaultCause::NEST);
+    }
+
+    if (fault == NoFault) {
+        Request::Flags memAccessFlags =
+            Request::STRICT_ORDER | Request::PHYSICAL | Request::HTM_START;
+        if (htm_depth > 1)
+            memAccessFlags = memAccessFlags | Request::NO_ACCESS;
+
+        fault = xc->initiateMemMgmtCmd(memAccessFlags);
+    }
+
+    return fault;
+}
+
+Fault
+XBeginInst::completeAcc(PacketPtr pkt, ExecContext *xc,
+                        trace::InstRecord *traceData) const
+{
+    Fault fault = NoFault;
+    uint64_t Mem;
+    uint64_t Dest64 = 0;
+    ThreadContext *tc = xc->tcBase();
+    const uint64_t htm_depth = xc->getHtmTransactionalDepth();
+
+    getMemLE(pkt, Mem, traceData);
+
+    if (Mem != 0)
+        fault = std::make_shared<InvalidOpcode>();
+
+    if (!xc->inHtmTransactionalState())
+        fault = std::make_shared<InvalidOpcode>();
+
+    if (fault == NoFault) {
+        Dest64 = 0;
+
+        if (htm_depth == 1) {
+            BaseHTMCheckpointPtr& cpt = xc->tcBase()->getHtmCheckpointPtr();
+            HTMCheckpoint *ckpt = dynamic_cast<HTMCheckpoint*>(cpt.get());
+            assert(ckpt != nullptr);
+            ckpt->save(tc);
+            PCState pc = tc->pcState().as<PCState>();
+            Addr target = pc.pc() + this->size() + rel;
+            ckpt->xbeginTarget(target);
+        }
+
+        xc->setRegOperand(this, 0, Dest64);
+        uint64_t final_val = Dest64;
+        if (traceData)
+            traceData->setData(intRegClass, final_val);
+    }
+
+    return fault;
+}
+
+Fault
+XEndInst::initiateAcc(ExecContext *xc, trace::InstRecord *traceData) const
+{
+    Fault fault = NoFault;
+    const uint64_t htm_depth = xc->getHtmTransactionalDepth();
+
+    if (!xc->inHtmTransactionalState())
+        fault = std::make_shared<InvalidOpcode>();
+
+    if (fault == NoFault) {
+        Request::Flags memAccessFlags =
+            Request::STRICT_ORDER | Request::PHYSICAL | Request::HTM_COMMIT;
+        if (htm_depth > 1)
+            memAccessFlags = memAccessFlags | Request::NO_ACCESS;
+
+        fault = xc->initiateMemMgmtCmd(memAccessFlags);
+    }
+
+    return fault;
+}
+
+Fault
+XEndInst::completeAcc(PacketPtr pkt, ExecContext *xc,
+                      trace::InstRecord *traceData) const
+{
+    Fault fault = NoFault;
+    uint64_t Mem;
+    ThreadContext *tc = xc->tcBase();
+    const uint64_t htm_depth = xc->getHtmTransactionalDepth();
+
+    getMemLE(pkt, Mem, traceData);
+
+    if (Mem != 0)
+        fault = std::make_shared<InvalidOpcode>();
+
+    if (fault == NoFault) {
+        if (htm_depth == 1) {
+            HTMCheckpoint *ckpt = static_cast<HTMCheckpoint*>(
+                xc->tcBase()->getHtmCheckpointPtr().get());
+            assert(ckpt);
+            assert(ckpt->valid());
+            ckpt->reset();
+        }
+    }
+
+    return fault;
+}
+
+Fault
+XAbortInst::initiateAcc(ExecContext *xc, trace::InstRecord *traceData) const
+{
+    Fault fault = NoFault;
+
+    if (!xc->inHtmTransactionalState())
+        fault = std::make_shared<InvalidOpcode>();
+
+    if (fault == NoFault) {
+        Request::Flags memAccessFlags =
+            Request::STRICT_ORDER | Request::PHYSICAL | Request::HTM_CANCEL;
+        fault = xc->initiateMemMgmtCmd(memAccessFlags);
+    }
+
+    return fault;
+}
+
+Fault
+XAbortInst::completeAcc(PacketPtr pkt, ExecContext *xc,
+                        trace::InstRecord *traceData) const
+{
+    Fault fault = NoFault;
+    uint64_t Mem;
+
+    getMemLE(pkt, Mem, traceData);
+
+    if (Mem != 0)
+        fault = std::make_shared<InvalidOpcode>();
+
+    if (fault == NoFault) {
+        fault = std::make_shared<GenericHtmFailureFault>(
+            xc->getHtmTransactionUid(),
+            HtmFailureFaultCause::EXPLICIT);
+    }
+
+    return fault;
+}
+
