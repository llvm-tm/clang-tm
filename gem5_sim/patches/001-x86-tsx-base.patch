diff --git a/configs/example/tsx_se.py b/configs/example/tsx_se.py
new file mode 100644
index 0000000000..dd29576e60
--- /dev/null
+++ b/configs/example/tsx_se.py
@@ -0,0 +1,97 @@
+import m5
+from m5.objects import *
+
+m5.util.addToPath("../../")
+
+from common.FileSystemConfig import config_filesystem
+from common.Caches import *
+
+import os
+import sys
+
+system = System()
+system.clk_domain = SrcClockDomain()
+system.clk_domain.clock = "2GHz"
+system.clk_domain.voltage_domain = VoltageDomain()
+system.mem_mode = "timing"
+system.mem_ranges = [AddrRange("512MiB")]
+
+binary = sys.argv[1]
+cpu = X86TimingSimpleCPU(cpu_id=0)
+system.cpu = cpu
+
+system.mem_ctrl = MemCtrl()
+system.mem_ctrl.dram = DDR3_1600_8x8()
+system.mem_ctrl.dram.range = system.mem_ranges[0]
+
+cpu.createInterruptController()
+
+# Ruby MESI_Three_Level_HTM setup
+system.ruby = RubySystem()
+system.ruby.number_of_virtual_networks = 3
+
+from topologies.SimplePt2pt import SimplePt2pt
+system.ruby.network = SimplePt2pt()
+system.ruby.network.number_of_virtual_networks = 3
+
+system.kernel = sys.argv[2] if len(sys.argv) > 2 else None
+
+# Set up the Ruby sequencer and cache controllers manually.
+# For simplicity, use a single controller with an ideal L0/L1/L2.
+
+# L0 cache controller (closest to core)
+system.ruby.l0_cntrl = RubyCacheController(
+    version=0,
+    ruby_system=system.ruby,
+)
+
+# L1 cache controller
+system.ruby.l1_cntrl = RubyCacheController(
+    version=0,
+    ruby_system=system.ruby,
+)
+
+# L2 cache controller
+system.ruby.l2_cntrl = RubyCacheController(
+    version=0,
+    ruby_system=system.ruby,
+)
+
+# Directory controller
+system.ruby.dir_cntrl = RubyDirectoryController(
+    version=0,
+    ruby_system=system.ruby,
+)
+
+# Sequencer
+system.ruby.sequencer = RubySequencer(
+    version=0,
+    ruby_system=system.ruby,
+)
+
+# Connect sequencer to CPU
+cpu.connectMemoryPorts(system.ruby.sequencer.in_ports)
+
+# Connect network
+system.ruby.network.connectControllers([
+    system.ruby.l0_cntrl,
+    system.ruby.l1_cntrl,
+    system.ruby.l2_cntrl,
+    system.ruby.dir_cntrl,
+])
+system.ruby.network.setup_buffers()
+
+process = Process()
+process.cmd = [binary]
+cpu.workload = process
+cpu.createThreads()
+
+system.workload = SEWorkload.init_compatible(binary)
+config_filesystem(system)
+
+root = Root(full_system=False, system=system)
+m5.instantiate()
+
+print(f"Beginning simulation! Running: {binary}")
+exit_event = m5.simulate()
+print(f"Exiting @ tick {m5.curTick()} because {exit_event.getCause()}")
