diff --git a/src/arch/x86/htm.cc b/src/arch/x86/htm.cc
new file mode 100644
index 0000000000..ca7fbbeee9
--- /dev/null
+++ b/src/arch/x86/htm.cc
@@ -0,0 +1,33 @@
+#include "arch/x86/htm.hh"
+
+namespace gem5
+{
+
+void
+X86ISA::HTMCheckpoint::reset()
+{
+    nPc = 0;
+    gpr.fill(0);
+    BaseHTMCheckpoint::reset();
+}
+
+void
+X86ISA::HTMCheckpoint::save(ThreadContext *tc)
+{
+    for (auto n = 0; n < int_reg::NumArchRegs; n++)
+        gpr[n] = tc->getReg(intRegClass[n]);
+    BaseHTMCheckpoint::save(tc);
+}
+
+void
+X86ISA::HTMCheckpoint::restore(ThreadContext *tc, HtmFailureFaultCause cause)
+{
+    for (auto n = 0; n < int_reg::NumArchRegs; n++)
+        tc->setReg(intRegClass[n], gpr[n]);
+    PCState pc = tc->pcState().as<PCState>();
+    pc.set(nPc);
+    tc->pcState(pc);
+    BaseHTMCheckpoint::restore(tc, cause);
+}
+
+} // namespace gem5
diff --git a/src/arch/x86/htm.hh b/src/arch/x86/htm.hh
