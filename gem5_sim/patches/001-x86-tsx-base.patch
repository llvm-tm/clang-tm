+
+namespace X86ISAInst
+{
+
+XBeginInst::XBeginInst(ExtMachInst machInst, int64_t _rel)
+    : X86ISA::X86StaticInst("xbegin", machInst, MemReadOp), rel(_rel)
+{
+    setRegIdxArrays(
+        nullptr,
+        reinterpret_cast<RegIdArrayPtr>(
+            &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
+
+    _numSrcRegs = 0;
+    _numDestRegs = 0;
+    setDestRegIdx(_numDestRegs++, intRegClass[0]);
+    _numTypedDestRegs[IntRegClass]++;
+    flags[IsHtmStart] = true;
+    flags[IsInteger] = true;
+    flags[IsLoad] = true;
+    flags[IsNonSpeculative] = true;
+}
+
+Fault
+XBeginInst::execute(ExecContext *xc, trace::InstRecord *traceData) const
+{
+    panic("XBEGIN not implemented for atomic memory");
+    return NoFault;
+}
+
+std::string
+XBeginInst::generateDisassembly(Addr pc,
+                                const loader::SymbolTable *symtab) const
+{
+    std::stringstream ss;
+    printMnemonic(ss, mnemonic);
+    ccprintf(ss, " %#x", pc + this->size() + rel);
+    return ss.str();
+}
+
+XEndInst::XEndInst(ExtMachInst machInst)
+    : X86ISA::X86StaticInst("xend", machInst, MemReadOp)
+{
+    _numSrcRegs = 0;
+    _numDestRegs = 0;
+    flags[IsHtmStop] = true;
+    flags[IsLoad] = true;
+    flags[IsNonSpeculative] = true;
+}
+
+Fault
+XEndInst::execute(ExecContext *xc, trace::InstRecord *traceData) const
+{
+    panic("XEND not implemented for atomic memory");
+    return NoFault;
+}
+
+std::string
+XEndInst::generateDisassembly(Addr pc,
+                              const loader::SymbolTable *symtab) const
+{
+    std::stringstream ss;
+    printMnemonic(ss, mnemonic);
+    return ss.str();
+}
+
+XAbortInst::XAbortInst(ExtMachInst machInst, uint8_t _imm)
+    : X86ISA::X86StaticInst("xabort", machInst, MemReadOp), imm(_imm)
+{
+    _numSrcRegs = 0;
+    _numDestRegs = 0;
+    flags[IsLoad] = true;
+    flags[IsNonSpeculative] = true;
+    flags[IsHtmCancel] = true;
+}
+
+Fault
+XAbortInst::execute(ExecContext *xc, trace::InstRecord *traceData) const
+{
+    panic("XABORT not implemented for atomic memory");
+    return NoFault;
+}
+
+std::string
+XAbortInst::generateDisassembly(Addr pc,
+                                const loader::SymbolTable *symtab) const
+{
+    std::stringstream ss;
+    printMnemonic(ss, mnemonic);
+    ccprintf(ss, " $%#x", imm);
+    return ss.str();
+}
+
+XTestInst::XTestInst(ExtMachInst machInst)
+    : X86ISA::X86StaticInst("xtest", machInst, MemReadOp)
+{
+    setRegIdxArrays(
+        nullptr,
+        reinterpret_cast<RegIdArrayPtr>(
+            &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
+
+    _numSrcRegs = 0;
+    _numDestRegs = 0;
+    setDestRegIdx(_numDestRegs++, intRegClass[0]);
+    _numTypedDestRegs[IntRegClass]++;
+    flags[IsInteger] = true;
+}
+
+Fault
+XTestInst::execute(ExecContext *xc, trace::InstRecord *traceData) const
+{
+    Fault fault = NoFault;
+    uint64_t Dest64 = xc->inHtmTransactionalState() ? 1 : 0;
+    xc->setRegOperand(this, 0, Dest64);
+    uint64_t final_val = Dest64;
+    if (traceData)
+        traceData->setData(intRegClass, final_val);
+    return fault;
+}
+
+std::string
+XTestInst::generateDisassembly(Addr pc,
+                               const loader::SymbolTable *symtab) const
+{
+    std::stringstream ss;
+    printMnemonic(ss, mnemonic);
+    return ss.str();
+}
+
+} // namespace X86ISAInst
+} // namespace gem5
